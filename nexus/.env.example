# ============================================================
# NEXUS MARKETPLACE — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ---- APP ----
APP_ENV=development          # development | staging | production
SPRING_PROFILE=dev           # dev | staging | prod

# ---- DATABASE ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus
DB_USER=nexus
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- REDIS ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---- SECURITY ----
# Must be >= 32 chars, high entropy
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM_SECRET_KEY_HERE
JWT_ACCESS_TTL_MS=900000       # 15 minutes
JWT_REFRESH_TTL_MS=2592000000  # 30 days

# ---- KAFKA ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=nexus-main

# ---- PAYMENT GATEWAYS ----
# Pagar.me
PAGARME_API_KEY=ak_live_CHANGE_ME
PAGARME_ENCRYPTION_KEY=ek_live_CHANGE_ME
PAGARME_WEBHOOK_SECRET=CHANGE_ME

# Gerencianet / EFI Bank (PIX)
GERENCIANET_CLIENT_ID=CHANGE_ME
GERENCIANET_CLIENT_SECRET=CHANGE_ME
GERENCIANET_PIX_KEY=CHANGE_ME_PIX_KEY
GERENCIANET_ENV=sandbox        # sandbox | production

# ---- EMAIL ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@nexus.com.br
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=Nexus Marketplace <noreply@nexus.com.br>

# ---- STORAGE (S3 or compatible) ----
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=nexus-marketplace
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1

# ---- SHIPPING ----
MELHOR_ENVIO_TOKEN=CHANGE_ME
MELHOR_ENVIO_ENV=sandbox       # sandbox | production
CORREIOS_USER=CHANGE_ME
CORREIOS_PASSWORD=CHANGE_ME

# ---- NOTIFICATIONS ----
FIREBASE_SERVER_KEY=CHANGE_ME  # For push notifications
TWILIO_ACCOUNT_SID=CHANGE_ME   # For SMS
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE=+55CHANGE_ME

# ---- FRONTEND ----
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_TENANT_DEFAULT=nexus
NEXT_PUBLIC_GA_ID=                      # Google Analytics

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.nexus.com.br

# ---- OBSERVABILITY ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=                     # Optional
LOG_LEVEL=INFO                   # TRACE | DEBUG | INFO | WARN | ERROR
