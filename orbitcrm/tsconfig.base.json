{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@orbitcrm/ui": ["packages/ui/src/index.tsx"],
      "@orbitcrm/types": ["packages/types/src/index.ts"],
      "@orbitcrm/utils": ["packages/utils/src/index.ts"],
      "@orbitcrm/config/*": ["packages/config/*"]
    }
  }
}
