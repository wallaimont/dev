# Shared
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
JWT_SECRET=super-secret-access-token
JWT_REFRESH_SECRET=super-secret-refresh-token
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://orbitcrm:orbitcrm@localhost:5432/orbitcrm?schema=public
REDIS_URL=redis://localhost:6379

# Storage / S3-compatible
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=orbitcrm
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true

# Email / billing
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_demo_key
SENDGRID_API_KEY=sg_demo_key
STRIPE_SECRET_KEY=sk_test_demo
STRIPE_WEBHOOK_SECRET=whsec_demo
