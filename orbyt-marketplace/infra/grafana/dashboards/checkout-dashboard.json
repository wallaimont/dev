      "title": "Taxa de Checkouts Bem-sucedidos",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [
        {"expr": "sum(rate(orbyt_checkout_requests_total{status=\"SUCCESS\"}[5m])) / clamp_min(sum(rate(orbyt_checkout_requests_total[5m])), 0.0001)", "legendFormat": "conversao", "refId": "A"}
      ],
      "title": "Conversão de Checkout",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "currencyBRL"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [
        {"expr": "sum(rate(orbyt_checkout_amount_sum[5m]))", "legendFormat": "valor/min", "refId": "A"}
      ],
      "title": "Volume Financeiro no Checkout",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
