      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(orbyt_checkout_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A"},
        {"expr": "histogram_quantile(0.50, sum(rate(orbyt_checkout_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "B"}
      ],
      "title": "Latência de Checkout",
