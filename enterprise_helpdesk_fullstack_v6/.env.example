APP_NAME=Enterprise Helpdesk API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@db:5432/helpdesk_db
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
DEFAULT_ADMIN_NAME=Administrador Geral
DEFAULT_ADMIN_EMAIL=admin@empresa.com
DEFAULT_ADMIN_PASSWORD=Admin1234
DEFAULT_COMPANY_NAME=Empresa Demo
DEFAULT_COMPANY_SEGMENT=Tecnologia
DEFAULT_SLA_LOW_HOURS=72
DEFAULT_SLA_MEDIUM_HOURS=24
DEFAULT_SLA_HIGH_HOURS=8
DEFAULT_SLA_CRITICAL_HOURS=4
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000
UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
